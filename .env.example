# Configuración del Observatorio Sísmico
# Copiar a .env y ajustar según sea necesario

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=terremotos.live
KAFKA_REPLAY_TOPIC=terremotos.replay

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio_secret_pw

# USGS Ingesta
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
INGESTION_INTERVAL_SECONDS=60
SNAPSHOT_RETENTION_HOURS=6

# FastAPI API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ngrok authtoken (opcional si se ejecuta ngrok en Docker)
NGROK_AUTHTOKEN=

